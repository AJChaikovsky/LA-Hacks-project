# Copy to .env and fill in. Never commit .env.

# ASI:One LLM (https://asi1.ai) — OpenAI-compatible, base URL https://api.asi1.ai/v1
ASI1_API_KEY=
ASI1_MODEL=asi1             # or asi1-mini (faster); scripts/llm_smoke.py times both
ASI1_JSON_MODE=             # on / off; empty = probe on first call. scripts/llm_smoke.py tells you which

# Agent seeds: any long random string, unique per agent AND per machine.
# Use different seeds on the always-on host than on your laptop.
COUNSELOR_SEED=
POINTS_SEED=
PAPERWORK_SEED=

# Specialist addresses (agent1q...), copied from each agent's startup log
POINTS_AGENT_ADDRESS=
PAPERWORK_AGENT_ADDRESS=

# Behaviour
USE_REMOTE_AGENTS=true      # false = call core/ in-process only
REMOTE_TIMEOUT_S=6          # then fall back to the local core/ call
LLM_TIMEOUT_S=12
DEMO_MODE=true              # temperature 0, cached golden email (.cache/), seeded resident school
CARDS=on                    # off = text-only replies
USE_STUBS=false             # true = core/stubs.py fixtures (dev-only escape hatch); the demo must use real modules
EMAIL_LLM=on                # off = template email only
EMAIL_MODEL=asi1-mini       # asi1 drafts take ~7 s; mini ~1.2 s
BROCHURE_LLM=on             # off = quote the best brochure passage instead of an LLM answer
BROCHURE_MODEL=asi1-mini
CASELOAD_SEED=
BUYER_SEED=
